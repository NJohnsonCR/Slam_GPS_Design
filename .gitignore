# Ignorar el ambiente virtual
project_env/*
slam_env/*
# Resultados de las corridas, salvo los cachés de KITTI que leen los
# invariantes (sanity_checks.py): ~400 KB, y sin ellos haría falta KITTI entero.
resultados/*
!resultados/rl_cache/
resultados/rl_cache/*
!resultados/rl_cache/*_cache.npz
# Y la caché de replays deterministas (realtime/cache.py): los resultados de
# grabaciones largas, para no reprocesarlas en cada computadora.
!resultados/cache/

# Ignorar archivos de caché de Python
__pycache__/
*.py[cod]

# Ignorar archivos de configuración de entornos virtuales
.venv/
env/
venv/

# Ignorar archivos de configuración de IDEs y editores de texto
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Ignorar dependencias instaladas desde pip
*.egg-info/
*.egg
dist/
build/

# Datos de entrada
kitti_data/*
mobile_data/*

# Modelos y checkpoints (excepto modelo final entrenado)
**/checkpoints/
**/backup_old_model/
**/*_checkpoint_*.pth

# Logs de entrenamiento y ejecución
**/logs/
*.log

# Archivos temporales de métricas
**/*_metrics_temp.json
**/*_training_report_*.json

# App móvil Android (fork de MARS Logger — vive en su propio repositorio)
android/
app/
mobile_app/
mars-logger/
mobile-ar-sensor-logger/
*.apk
*.aab
*.keystore
.gradle/
local.properties
**/build/outputs/
